# LLM API Configuration
# Choose one of the following providers

# OpenAI API Key (recommended for gpt-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (alternative for claude-3-5-haiku)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LLM Provider: 'openai' or 'anthropic'
LLM_PROVIDER=openai

# Model to use
# For OpenAI: gpt-4o-mini (fast and cost-effective)
# For Anthropic: claude-3-5-haiku-20241022
LLM_MODEL=gpt-4o-mini
